.append(\"resourceId\", resourceId);\n\treturn fetch('/api/v1/dms/73861c5a-5941-11e5-9b54-9457a56d2858/object/module?publicAccessURL=false', {   \n\t\t\t\tmethod: \"POST\", \n\t\t\t\tbody: formData,\n\t\t\t    headers: {\n\t\t\t    \t/* \"Content-Type\":\"application/octet-stream\", */\n\t\t\t    \t\"userId\":'16110',\n\t\t\t        \"x-api-key\": 'juno-api-key',\n\t\t\t    }\n\t\t\t})\n\t\t\t.then(response => {\n\t\t        if (!response.ok) {\n\t\t            return `Upload failed, response code `;\n\t\t        }\n\t\t\t    return response.json(); \n\t\t\t})\n\t\t\t.catch(error => {\n\t\t\t  \tconsole.error(\"Upload error:\", error);\n\t\t     \treturn \"Upload failed due to an error\";\n\t\t\t});\n}\njuno.getDMSModuleDocumentsV2 = (category, stringifiedRequestBody) => {\n    const headers = {\n    \t\"userId\":'16110',\n        \"x-api-key\": 'juno-api-key',\n        \"Content-Type\": \"application/json; charset=utf-8\"\n    };\n\n    const options = {\n        method: \"POST\",\n        headers: headers,\n        body: stringifiedRequestBody\n    };\n    \n    return fetch('/api/v1/dms/common/module?category='+category, options)\n        .then(response => {\n            if (!response.ok) {\n                return Promise.reject(`Failed to receive document list, response code `);\n            }\n            return response.json();\n        })\n        .then(responseBody => {\n            return responseBody; \n        })\n        .catch(error => {\n            console.error(\"Error making the request:\", error);\n            throw error;\n        });\n}\n\njuno.getDMSModuleDocumentsByResourceV2 = (resource, resourceId) => {\n    const headers = {\n    \t\"userId\":'16110',\n        \"x-api-key\": 'juno-api-key',\n        \"Content-Type\": \"application/json; charset=utf-8\"\n    };\n\n    const options = {\n        headers: headers,\n    };\n    \n    return fetch('/api/v1/dms/common/resource?resource='+resource+'&resourceId='+resourceId, options)\n        .then(